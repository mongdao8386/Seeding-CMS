# TikTok Signature Server Configuration
# Copy this file to .env and fill in your values

# Server port (default: 8080)
PORT=8080

# Proxy Configuration (optional)
# Set PROXY_ENABLED=true to use a proxy
PROXY_ENABLED=false
PROXY_HOST=proxy.example.com:8080
PROXY_USER=your_username
PROXY_PASS=your_password

# Chrome executable path (optional, auto-detected by default)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Auto-refresh tuning (optional)
# Restart browser after this many signatures (default: 500)
#MAX_GENERATIONS_BEFORE_REFRESH=500
# Restart browser after this many ms of session age (default: 1800000 = 30 min)
#MAX_SESSION_AGE_MS=1800000

# User agent for the signing page (optional). X-Gnarly hashes the UA, so requests you
# send with a signature from this server must carry the same UA.
# Known limit: a Firefox UA breaks local-SDK init (frontierSign never appears) - use a WebKit/Chromium UA.
#SIGNER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:152.0) Gecko/20100101 Firefox/152.0
