# Sao chep thanh .env roi dien gia tri that. KHONG commit .env.

DATABASE_URL=postgresql+asyncpg://seeding:seeding@localhost:5433/seeding
REDIS_URL=redis://localhost:6380

# Cua so stagger mac dinh (giay). Job trong cung mot Group se duoc rai deu
# ngau nhien trong khoang [0, STAGGER_WINDOW_SECONDS] ke tu thoi diem bat dau.
STAGGER_WINDOW_SECONDS=3600

# Tran so bai moi tai khoan duoc dang trong 24h khi chua qua warm-up.
DEFAULT_DAILY_CAP=3

# So ngay warm-up: trong giai doan nay tran tang dan tu 1 den daily_cap.
WARMUP_DAYS=3
# Bao nhieu ngay dau KHONG dang gi ca (chi tuong tac). 2 = dang tu ngay thu ba.
WARMUP_QUIET_DAYS=2

# User-Agent gui kem moi request Reddit. Reddit yeu cau chuoi mo ta ro rang.
REDDIT_USER_AGENT=seeding-cms/0.1 by u/your_main_account

# Kho media. File goc dat o MEDIA_ROOT/sources, ban bien the sinh ra o /variants.
MEDIA_ROOT=./media
# subtle = mat thuong khong thay, chi pha duoc hash file
# moderate = pHash bat dau dich
# aggressive = co lat guong, pHash dich ro nhung nhin ra duoc
MEDIA_STRENGTH=moderate

# Noi cat file goc: local | supabase
# local    = thu muc MEDIA_ROOT tren may nay. Du neu ban chi chay mot may.
# supabase = nhieu worker dung chung mot kho, o dia may khong phinh theo chien dich.
#            Doi lai: media la noi dung seeding cua ban, va no se nam tren may chu
#            cua ben thu ba. Ban bien the van luon o may, khong bao gio day len.
MEDIA_BACKEND=local
SUPABASE_URL=
# Service key (secret), KHONG phai anon/publishable key.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=seeding-media

# Bao ra ngoai khi co tai khoan ket. De trong = tat.
# Acc ket luc 2h sang thi nam im toi khi ban mo dashboard - webhook rut cho do tu
# hang gio xuong hang phut. Tin nhan KHONG bao gio chua mat khau, ma 2FA hay cookie.
#
#   discord  -> URL webhook cua kenh
#   slack    -> URL incoming webhook
#   telegram -> https://api.telegram.org/bot<TOKEN>/sendMessage + ALERT_TELEGRAM_CHAT_ID
# Instagram qua aiograpi (cookie sessionid, proxy cua profile). false = chi mo tay.
INSTAGRAM_ENABLED=true
# X qua twifork (cookie auth_token + ct0). Thu vien lech thi Cai dat bao; pip install -U twifork.
X_ENABLED=true
# Reddit qua API (script app, bi mat trong cot client_id/client_secret/username/password khi dan).
REDDIT_ENABLED=true
# Facebook bang trinh duyet that - cham, khong nuoi tu dong.
FACEBOOK_ENABLED=true

# Chatbot: tu tra loi binh luan duoi bai cua acc (TikTok/IG/X/Reddit) va tin nhan (IG/X).
# TAT mac dinh. Co ANTHROPIC_API_KEY thi Claude viet cau tra loi theo giong persona;
# khong co thi dung bo cau mau tieng Viet.
CHATBOT_ENABLED=false
CHATBOT_COMMENTS=true
CHATBOT_DMS=true
CHATBOT_INTERVAL_MINUTES=10
CHATBOT_MAX_PER_HOUR=8
CHATBOT_REPLY_RATIO=0.8
CHATBOT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Nuoi: binh luan kieu gi (sticker = chi emoji | text | mixed) va tu khoa tim dich (dau phay).
WARM_COMMENT_STYLE=sticker
# TikTok: tha tim/follow/binh luan bang trinh duyet (browser, mac dinh) hay HTTP (cong ghi dang chan).
TIKTOK_ACTIONS=browser
# Host tinh (JS/CSS/anh) di thang khong qua proxy - trang TikTok qua proxy dan cu moi ve. Trong = tat.
BROWSER_STATIC_BYPASS=
WARM_KEYWORDS=

ALERT_KIND=generic
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO

# Khoa ma hoa ket bi mat. Sinh bang: python scripts/gen_vault_key.py
# MAT KHOA LA MAT TOAN BO COOKIE JAR - sao luu rieng, khong de chung voi backup DB.
VAULT_KEY=

# Token bao ve API va dashboard. Sinh bang: python scripts/gen_api_token.py
# De trong thi API tu choi moi request - co y fail-closed.
API_TOKEN=
